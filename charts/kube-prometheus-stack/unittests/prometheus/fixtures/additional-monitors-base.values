prometheus:
  additionalServiceMonitors:
    api:
      additionalLabels:
        team: platform
        environment: base
      jobLabel: app
      selector:
        matchLabels:
          app: api
      endpoints:
        - port: http
    worker:
      selector:
        matchLabels:
          app: worker
      endpoints:
        - port: metrics
  additionalPodMonitors:
    api:
      additionalLabels:
        team: platform
        environment: base
      jobLabel: app
      selector:
        matchLabels:
          app: api
      podMetricsEndpoints:
        - port: http
    worker:
      selector:
        matchLabels:
          app: worker
      podMetricsEndpoints:
        - port: metrics
